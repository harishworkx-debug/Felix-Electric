{
  "redirects": [
    {
      "source": "/electrical-services-:area",
      "destination": "/electrician-:area",
      "permanent": true
    },
    {
      "source": "/electrical-services-:area/",
      "destination": "/electrician-:area",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
